# Copy to .env. Every setting in src/catalogsnap/config.py can be set as CATALOGSNAP_<NAME>.

CATALOGSNAP_CUTOUT_MODEL=birefnet-general-lite
CATALOGSNAP_SCENE_BACKEND=studio

# Needed only for CATALOGSNAP_SCENE_BACKEND=kontext (FLUX.1 Kontext, https://api.bfl.ai)
CATALOGSNAP_BFL_API_KEY=

# Brand look
CATALOGSNAP_BACKGROUND_TOP=#f6f4f0
CATALOGSNAP_BACKGROUND_BOTTOM=#e7e3db

# Guardrail thresholds
CATALOGSNAP_MIN_SSIM=0.80
CATALOGSNAP_MAX_DELTA_E=9.0
CATALOGSNAP_MAX_ATTEMPTS=3
